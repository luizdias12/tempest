APP_ENV=production_development_maintenance

SESSION_INATIVIDADE_MIN=480

LDAP_URL=url
LDAP_SEARCHBASE=search_base
LDAP_NAMEATTR=name_attr
LDAP_DOMAIN=domain_name

DB_RM_HOST=host
DB_RM_USER=user
DB_RM_PASSWORD=password
DB_RM_SERVICENAME=servicename

DB_C5_HOST=host
DB_C5_USER=user
DB_C5_PASSWORD=password
DB_C5_SERVICENAME=servicename

DB_TAF_HOST=host
DB_TAF_USER=user
DB_TAF_PASSWORD=password
DB_TAF_SERVICENAME=servicename

MYSQL_HOST=host
MYSQL_DBNAME=dbname
MYSQL_USER=user
MYSQL_PASSWORD=password

MAIL_HOST=host
MAIL_PORT=port
MAIL_AUTH=true_false
MAIL_USERNAME=mail_username
MAIL_PASSWORD=password
MAIL_ENCRYPTION=encryption
MAIL_FROM=mail_account
MAIL_FROM_NAME=mail_from

ORACLE_LIB_DIR=/path/to/oracle/client

JWT_SECRET=your-secret-here
JWT_ISSUER=
JWT_AUDIENCE=
JWT_TTL=3600
JWT_ALGORITHM=HS256

CHAT_KEY=base64-32-bytes

AZURE_TENANT_ID=tenant
AZURE_CLIENT_ID=client_id
AZURE_CLIENT_SECRET=client_secret
SUPPORT_MAILBOX=helpdesk@seu-dominio.com.br
GRAPH_PASTA=Chamados

# ── Vivi (assistente virtual) ──────────────────────────────────────────────
# Qualquer provedor compatível com a API OpenAI serve. Exemplos:
#   Ollama local (grátis/privado): http://127.0.0.1:11434/v1  (modelo: qwen2.5:7b-instruct)
#   Groq (plano gratuito):         https://api.groq.com/openai/v1 (modelo: openai/gpt-oss-20b)
#   OpenRouter (modelos :free):    https://openrouter.ai/api/v1
# Para Ollama: instale, rode `ollama pull qwen2.5:7b-instruct` e
# `ollama pull bge-m3` (embeddings). Use OLLAMA_HOST=127.0.0.1 se necessário.
VIVI_BASE_URL=http://127.0.0.1:11434/v1
VIVI_API_KEY=ollama
VIVI_MODEL=qwen2.5:7b-instruct
# Embeddings são opcionais. Vazio = busca por texto (FULLTEXT).
# Provedores sem endpoint de embeddings (ex.: Groq) devem deixar vazio.
VIVI_EMBED_MODEL=bge-m3
VIVI_TIMEOUT=60
VIVI_TOP_K=5
VIVI_MAX_MSG=1000
VIVI_MAX_TOKENS=700
VIVI_TEMPERATURA=0.2
VIVI_MAX_CONTEXTO=6000
VIVI_MAX_RESPOSTA=2000
VIVI_MAX_CHUNKS_BUSCA=1500
VIVI_SCORE_MIN=0.25
VIVI_RATE_IP_MIN=60
VIVI_RATE_MIN=12
VIVI_RATE_DIA=300